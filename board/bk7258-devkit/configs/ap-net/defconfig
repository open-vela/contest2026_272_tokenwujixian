# Button support
CONFIG_INPUT=y
CONFIG_INPUT_BUTTONS=y
CONFIG_INPUT_BUTTONS_LOWER=y
CONFIG_ARCH_BUTTONS=y
CONFIG_ARCH_IRQBUTTONS=y
CONFIG_INPUT_BUTTONS_DEBOUNCE_DELAY=30
CONFIG_NSH_ARCHINIT=y
# --- ap-net: NuttX native network stack over RPMsg (peer of CP rpmsg0) ---
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_STATISTICS=y
CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_IPv4=y
CONFIG_NET_ARP=y
CONFIG_NET_ICMP=y
CONFIG_NET_IGMP=y
CONFIG_IOB_BUFSIZE=640
CONFIG_NET_ETH_PKTSIZE=590
CONFIG_NET_LL_GUARDSIZE=48
CONFIG_NSH_PROCFS_MOUNTPOINT="/proc"
CONFIG_SYSTEM_PING=y
CONFIG_SYSTEM_PING_PROGNAME="ping"
CONFIG_SYSTEM_PING_PRIORITY=100
CONFIG_SYSTEM_PING_STACKSIZE=2048
# Needed by the user-mode ping (icmp_ping.c uses setsockopt + ICMP sockets)
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_ICMP_SOCKET=y
# Cross-core networking, Vela standard: PF_RPMSG socket domain toward
# the CP; no netdev, no IP address on this core (NET_RPMSG_DRV abandoned).
CONFIG_NET_RPMSG=y
CONFIG_EXAMPLES_RPMSGSOCKET=y
# usrsock client: this core's applications use normal sockets, executed by the
# CP's usrsock server over RPMSG (NET_USRSOCK_RPMSG + CPUNAME "cp"). Mirrors the
# sim rpproxy reference; replaces the abandoned NET_RPMSG_DRV netdev approach.
CONFIG_NET_USRSOCK=y
CONFIG_NET_USRSOCK_RPMSG=y
CONFIG_NET_USRSOCK_RPMSG_CPUNAME="cp"
CONFIG_NET_USRSOCK_TCP=y
CONFIG_NET_USRSOCK_UDP=y
CONFIG_NET_USRSOCK_ICMP=y
# Let Ctrl+C deliver SIGINT to the foreground task group on this console.
CONFIG_TTY_SIGINT=y
CONFIG_TTY_SIGINT_CHAR=0x03
# DNS resolution on the AP: the usrsock rpmsg transport carries DNS requests
# to the CP's resolver (usrsock_rpmsg_dns_handler); without NETDB_DNSCLIENT
# the AP has no gethostip at all and every hostname command fails before
# reaching the network.
CONFIG_NETDB_DNSCLIENT=y
# --- minimal ai_agent support layer ---
# ai_agent's Phase-0 bootstrap mounts /data as tmpfs itself when the
# directory is absent (agent_main.c:541); it only needs the fs type
# registered. tmpfs also gives a writable /etc for openssl config.
CONFIG_FS_TMPFS=y
# TLS + JSON: the remaining config-only dependencies for the minimal
# agent (channels all off); needed later by MQTT anyway.
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_NETUTILS_CJSON=y
# Minimal ai_agent: core only, every channel (MQTT/Feishu/MCP/Node/Weixin)
# off. Runs on the AP over usrsock; /data is self-mounted as tmpfs.
CONFIG_EXAMPLES_AI_AGENT_VELA=y
CONFIG_EXAMPLES_AI_AGENT_VELA_STACKSIZE=32768
# CONFIG_AI_AGENT_MQTT is not set
# CONFIG_AI_AGENT_FEISHU is not set
# CONFIG_AI_AGENT_MCP is not set
# CONFIG_AI_AGENT_NODE is not set
# CONFIG_AI_AGENT_WEIXIN is not set
# ai_agent runs on this core over usrsock (no local wlan0); its
# wifi_connect takes the rpmsg path instead of shelling out to wapi.
CONFIG_AI_AGENT_NET_RPMSG=y
# Trim the agent to what this board can use: no local media player,
# no wearable sensors, no quickapp runtime on the AP, and the ws server
# accept thread does not fit the post-loop heap (ENOMEM at 25K free).
# MQTT stays enabled -- it is the channel this board will actually use.
# CONFIG_AI_AGENT_WS_SERVER is not set
# CONFIG_AI_AGENT_TOOLS_WEARABLE is not set
# CONFIG_AI_AGENT_TOOLS_MEDIA is not set
# CONFIG_AI_AGENT_TOOLS_QUICKAPP is not set
# PSRAM: the AP gets the upper half of the 16MB device (the CP owns the
# lower half; see the split in chips/bk7258/bk7258_allocateheap.c).
# Needed for the ai_agent's LLM response buffers: 244KB SRAM is not enough.
CONFIG_BK7258_PSRAM=y
CONFIG_MM_REGIONS=2
