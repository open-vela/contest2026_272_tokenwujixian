CONFIG_TTY_SIGINT_CHAR=0x03
# The usrsock server executes the AP's sockets on this core; TCP was never
# needed before (DNS/DHCP=UDP, ping=ICMP) but the AP's SOCK_STREAM requests
# now arrive here and inet_setup rejects them with EPROTONOSUPPORT.
# Required for ws_server today and the MQTT channel later.
CONFIG_NET_TCP=y
# TCP write buffering, small first step.  Without it send() hands one segment
# to the driver and blocks on the next; measured 0.07-0.10 Mbit/s while UDP
# reached 8.9 Mbit/s on the same link.  The Armino baseline runs lwIP with
# SND_BUF=21900, but the IOB pool is a static SRAM array and the CP SRAM heap
# collapses below ~16 KiB if the pool grows (IOB_NBUFFERS=22 left 12.8 KiB and
# the AP stalled waiting for a CP allocation).  The pool now sits at 40 only
# because the AP moved 48 KiB of bulk statics to PSRAM; the write buffer is a
# per-socket cap that draws from that pool, so 21900 (= lwIP's TCP_SND_BUF)
# costs no static SRAM.  Measured at 2000 B app blocks: CP 4.29 Mbit/s with a
# 16 KiB cap vs the Armino baseline's 7.17 with 21.9 KiB.
CONFIG_NET_TCP_WRITE_BUFFERS=y
# 16 rather than 8: each 2000 B write becomes 1460 + 540, so one write queues
# two segments and 8 chain heads cap the in-flight writes at ~16 KB -- the same
# size as the old send buffer.  Chain heads are tiny; this costs no IOB.
CONFIG_NET_TCP_NWRBCHAINS=24
# 64 KiB window against the measured 55 ms RTT (window/RTT is what set the
# old ceiling: 21.9 KiB / 55 ms ~= 400 KB/s).  Affordable now that
# bk7258_netbuf.c replaced the six lwIP units: the CP got back mem.c's 50 KiB
# MEM_SIZE arena and memp.c's pool, which is what the 64 KiB pbuf arena is
# paid out of.  The window is backed by the IOB pool at 56 x 1528 B; CP SRAM
# sits at 91.5%.
# 24 KiB, not 64: in-flight bytes are what the arena must back, and each TCP
# frame costs two pbufs of (724 + len) bytes (rwnx_start_xmit allocates a second
# one under CONFIG_WAPI_SUPPORT).  With 88 KiB of arena that is ~20 frames
# ~= 29 KiB in flight; a larger send window only turns into Transmit -12.
CONFIG_NET_SEND_BUFSIZE=24576
