CONFIG_ARCH="arm"
CONFIG_ARCH_CHIP_ARM_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/beken/chips/bk7258"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="bk7258"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/beken/boards/bk7258/bk7258-devkit"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="bk7258-devkit"
CONFIG_ARCH_BOARD_BK7258_DEVKIT=y
CONFIG_ARCH_BOARD_BK7258_DEVKIT_BUTTONS=y
CONFIG_ARCH_HAVE_BUTTONS=y
CONFIG_ARCH_HAVE_IRQBUTTONS=y
CONFIG_ARCH_CHIP_BK7258=y
CONFIG_BK7258_COMPONENT_AP=y
CONFIG_ARCH_TRUSTZONE_SECURE=y
CONFIG_ARCH_IRQPRIO=y
CONFIG_ARCH_INTERRUPTSTACK=4096
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARMV8M_SYSTICK=y
CONFIG_ARMV8M_DCACHE=y
CONFIG_ARMV8M_ICACHE=y
# ARMv8-M MPU: opaque Bootloader may configure the MPU, and shared SRAM
# (RPMsg/SWAP/PWR_MNG + Wi-Fi pbufs) must stay non-cacheable for D-cache
# to run.  bk7258_mpuinit() programs the region table at every core start.
CONFIG_ARM_MPU=y
CONFIG_ARM_MPU_NREGIONS=8
CONFIG_BOARD_EARLY_INITIALIZE=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARDCTL=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BUILTIN=y
CONFIG_DEBUG_ASSERTIONS=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_HARDFAULT_ALERT=y
CONFIG_DEBUG_MEMFAULT=y
CONFIG_DEBUG_BUSFAULT=y
CONFIG_DEBUG_USAGEFAULT=y
CONFIG_DEBUG_SECUREFAULT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEV_CONSOLE=y
CONFIG_DEV_SIMPLE_ADDRENV=y
CONFIG_IDLETHREAD_STACKSIZE=8192
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=8192
CONFIG_INTELHEX_BINARY=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_PROMPT_STRING="nsh-ap> "
CONFIG_NSH_READLINE=y
CONFIG_PREALLOC_TIMERS=4
CONFIG_RAM_SIZE=344064
CONFIG_RAM_START=0x28010000
CONFIG_RAW_BINARY=y
# CONFIG_SMP is not set
CONFIG_SMP_NCPUS=1
CONFIG_BK7258_MAILBOX=y
CONFIG_RPMSG_LOCAL_CPUNAME="ap"
CONFIG_RPMSG_PING=y
CONFIG_RPMSG_UART=y
CONFIG_RPMSG_UART_CONSOLE=y
CONFIG_RPTUN=y
CONFIG_RPTUN_AUTO_RESET_DISABLE=y
CONFIG_RPTUN_PRIORITY=90
CONFIG_RPTUN_STACKSIZE=8192
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SERIAL=y
CONFIG_START_DAY=1
CONFIG_START_YEAR=2026
CONFIG_SYSTEM_NSH=y
CONFIG_USEC_PER_TICK=1000

# Audio support
CONFIG_DRIVERS_AUDIO=y
CONFIG_AUDIO=y
CONFIG_AUDIO_BK7258=y
CONFIG_AUDIO_BK7258_CAPTURE=y
CONFIG_AUDIO_EXCLUDE_STOP=n
CONFIG_AUDIO_MULTI_SESSION=n
CONFIG_AUDIO_FORMAT_PCM=y
CONFIG_AUDIO_NUM_BUFFERS=4
CONFIG_AUDIO_BUFFER_NUMBYTES=4096
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_WORKQUEUE=y
CONFIG_DEBUG_AUDIO=y
CONFIG_TESTING_BK7258_PCM=y
CONFIG_TESTING_BK7258_BTN=y
CONFIG_LIBM=y
CONFIG_SYSLOG_CHARDEV=y
CONFIG_SYSLOG_CONSOLE=y
CONFIG_SYSLOG_DEVPATH="/dev/ttyS0"
CONFIG_FS_PROCFS=y

# Button support
CONFIG_INPUT=y
CONFIG_INPUT_BUTTONS=y
CONFIG_INPUT_BUTTONS_LOWER=y
CONFIG_ARCH_BUTTONS=y
CONFIG_ARCH_IRQBUTTONS=y
CONFIG_INPUT_BUTTONS_DEBOUNCE_DELAY=30
CONFIG_NSH_ARCHINIT=y

# --- Cross-core networking + AI agent (merged from the ap-net experiment) ---
# The AP's sockets execute on the CP over usrsock/RPMsg; the PSRAM upper
# half adds 8MB to this core's heap; the minimal ai_agent runs here.
# Rationale per setting is documented in configs/ap-net (kept as the
# experiment config); this file is the default full-featured AP image.
CONFIG_TASK_NAME_SIZE=24
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_STATISTICS=y
CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_IPv4=y
CONFIG_NET_ARP=y
CONFIG_NET_ICMP=y
CONFIG_NET_IGMP=y
CONFIG_IOB_BUFSIZE=640
CONFIG_NET_ETH_PKTSIZE=590
CONFIG_NET_LL_GUARDSIZE=48
CONFIG_NSH_PROCFS_MOUNTPOINT="/proc"
CONFIG_SYSTEM_PING=y
# ai_agent nsh_commands calls system(3); the system app provides it.
CONFIG_SYSTEM_SYSTEM=y
CONFIG_SYSTEM_PING_PROGNAME="ping"
CONFIG_SYSTEM_PING_PRIORITY=100
CONFIG_SYSTEM_PING_STACKSIZE=2048
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_RPMSG=y
CONFIG_EXAMPLES_RPMSGSOCKET=y
CONFIG_NET_USRSOCK=y
CONFIG_NET_USRSOCK_RPMSG=y
CONFIG_NET_USRSOCK_RPMSG_CPUNAME="cp"
CONFIG_NET_USRSOCK_TCP=y
CONFIG_NET_USRSOCK_UDP=y
CONFIG_NET_USRSOCK_ICMP=y
CONFIG_TTY_SIGINT=y
CONFIG_TTY_SIGINT_CHAR=0x03
CONFIG_NETDB_DNSCLIENT=y
CONFIG_FS_TMPFS=y
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_NETUTILS_CJSON=y
CONFIG_EXAMPLES_AI_AGENT_VELA=y
CONFIG_EXAMPLES_AI_AGENT_VELA_STACKSIZE=32768
CONFIG_AI_AGENT_NET_RPMSG=y
# 路 B (dual-core BK7258): AP drives the CP-side chat UI over RPMsg.  The AP
# has no LCD/LVGL/FPU; ui_rpmsg_client.c is a drop-in shim that implements
# lvgl_ui_channel_* + lvgl_toast_* as RPMsg messages to the CP renderer.
CONFIG_AI_AGENT_UI_RPMSG=y
# M5 PTT: physical S1 button (GPIO13) hold-to-talk on the AP core. The
# buttons + voice pipeline + UI shim are all on AP, so no reverse RPMsg:
# press → voice_channel_start + set_ptt(RECORDING); release →
# voice_channel_stop_with_text + send_user echo + dispatch → LLM → reply.
CONFIG_AI_AGENT_PTT=y
CONFIG_BK7258_PSRAM=y
CONFIG_MM_REGIONS=2
CONFIG_SERIAL_NPOLLWAITERS=8
# Agent channels/tools trimmed for this board (no media player, no wearable
# sensors, no quickapp runtime; ws accept thread ENOMEM on post-loop heap).
# CONFIG_AI_AGENT_MQTT is not set
# CONFIG_AI_AGENT_WS_SERVER is not set
# CONFIG_AI_AGENT_TOOLS_WEARABLE is not set
# CONFIG_AI_AGENT_TOOLS_MEDIA is not set
# CONFIG_AI_AGENT_TOOLS_QUICKAPP is not set
