# --- Cross-core networking + AI agent (merged from the ap-net experiment) ---
# The AP's sockets execute on the CP over usrsock/RPMsg; the PSRAM upper
# half adds 8MB to this core's heap; the minimal ai_agent runs here.
# Rationale per setting was documented in configs/ap-net, now retired (see
# git history); this file is the default full-featured AP image.
CONFIG_TASK_NAME_SIZE=24
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_STATISTICS=y
CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_IPv4=y
CONFIG_NET_ARP=y
CONFIG_NET_ICMP=y
CONFIG_NET_IGMP=y
# The AP's sockets are usrsock -- the TCP stack lives on the CP -- but the
# usrsock transfer path can still buffer here. IOB_ALLOC lets that overflow
# into the heap (the AP has the upper 8 MiB of PSRAM).
CONFIG_IOB_ALLOC=y
# TLS certificates are only valid inside their date window, so the AP needs
# a real clock. The board has no RTC sync; vela_tls used to force the clock
# to a 2026 guess ("Clock too old, forcing to 2026").
CONFIG_NETUTILS_NTPCLIENT=y
CONFIG_NETUTILS_NTPCLIENT_SERVER="ntp1.aliyun.com;ntp1.ntsc.ac.cn;ntp1.cstnet.cn"
CONFIG_NETUTILS_NTPCLIENT_NUM_SAMPLES=1
# The daemon resolves the server itself: lib_dnsquery.c keeps qname[258]
# plus a 512 B query buffer on the stack, which overflows the 2048 default.
CONFIG_NETUTILS_NTPCLIENT_STACKSIZE=4096
CONFIG_STACK_COLORATION=y
# ps showed rpmsg-cp-0 at 3588 of 4016 B (89%) with the console on the AP.
CONFIG_RPMSG_WQUEUE_STACKSIZE=8192
# NSH `ntpc_start` / `ntpc_stop`, plus netinit_auto-starts the daemon
CONFIG_SYSTEM_NTPC=y
CONFIG_IOB_BUFSIZE=640
CONFIG_NET_ETH_PKTSIZE=590
CONFIG_NET_LL_GUARDSIZE=48
CONFIG_NSH_PROCFS_MOUNTPOINT="/proc"
CONFIG_SYSTEM_PING=y
CONFIG_NETUTILS_IPERF=y
CONFIG_SYSTEM_PING_PROGNAME="ping"
CONFIG_SYSTEM_PING_PRIORITY=100
CONFIG_SYSTEM_PING_STACKSIZE=2048
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_RPMSG=y
CONFIG_EXAMPLES_RPMSGSOCKET=y
CONFIG_NET_USRSOCK=y
CONFIG_NET_USRSOCK_RPMSG=y
CONFIG_NET_USRSOCK_RPMSG_CPUNAME="cp"
CONFIG_NET_USRSOCK_TCP=y
CONFIG_NET_USRSOCK_UDP=y
CONFIG_NET_USRSOCK_ICMP=y
CONFIG_TTY_SIGINT=y
CONFIG_TTY_SIGINT_CHAR=0x03
CONFIG_NETDB_DNSCLIENT=y
CONFIG_FS_TMPFS=y
CONFIG_CRYPTO_MBEDTLS=y
# One TLS record must fit in 3 of the 4 AP->CP rptun buffers (2 KiB each):
# usrsock_rpmsg_server holds every fragment until the request is complete.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_NETUTILS_CJSON=y
CONFIG_NETUTILS_MQTTC=y
CONFIG_EXAMPLES_AI_AGENT_VELA=y
CONFIG_EXAMPLES_AI_AGENT_VELA_STACKSIZE=32768
CONFIG_AI_AGENT_NET_RPMSG=y
CONFIG_BK7258_PSRAM=y
CONFIG_MM_REGIONS=2
# PSRAM layout, one slab per purpose (bk7258_memorymap.h derives the bases).
# Sum must stay within the fitted device: 16 MiB on the APS128XXO.
CONFIG_BK7258_PSRAM_DISPLAY_SIZE=0x400000
CONFIG_BK7258_PSRAM_AUDIO_SIZE=0x80000
CONFIG_BK7258_PSRAM_ENCODE_SIZE=0x100000
CONFIG_BK7258_PSRAM_SECTION_SIZE=0x80000
CONFIG_BK7258_PSRAM_CP_HEAP_SIZE=0x500000
CONFIG_BK7258_PSRAM_AP_HEAP_SIZE=0x500000
CONFIG_SERIAL_NPOLLWAITERS=8
# Agent channels/tools trimmed for this board (no media player, no wearable
# sensors, no quickapp runtime; ws accept thread ENOMEM on post-loop heap).
CONFIG_AI_AGENT_MQTT=y
CONFIG_AI_AGENT_REMOTE_CTRL=y
# No media server here: media_recorder/player are weak stubs, so voice
# needs the direct /dev/audio/pcm0c + pcm0p backend.
CONFIG_AI_AGENT_AUDIO_NUTTX_DIRECT=y
# Default 16 is too small to hold two MCP servers: gerrit exposes 15 tools
# and jira 16, and discover_server_tools() hands each server
# (MCP_CLIENT_MAX_TOOLS - total) slots.  At 16 the second server silently
# gets the remainder -- seen on the board as "jira: discovered 1 tools"
# and the model answering "我没有 jira_get_issue 工具".  32 slots is
# ~14.4 KB BSS; 64 doubles that and leaves headroom past a third
# server.
CONFIG_AI_AGENT_MCP_MAX_TOOLS=64
# CONFIG_AI_AGENT_WS_SERVER is not set
# CONFIG_AI_AGENT_TOOLS_WEARABLE is not set
# CONFIG_AI_AGENT_TOOLS_MEDIA is not set
# CONFIG_AI_AGENT_TOOLS_QUICKAPP is not set
# Both channels default to y and long-poll without credentials, holding
# sockets and IOBs that starve the TLS path during the LLM bring-up.
# CONFIG_AI_AGENT_FEISHU is not set
# CONFIG_AI_AGENT_WEIXIN is not set
CONFIG_FRAME_POINTER=y
CONFIG_SCHED_BACKTRACE=y
# The syslog channel is the RPMsg console, whose write takes a mutex: a
# syslog() from an interrupt (rptun.c:768 "Panic by remote core") asserted
# in nxmutex_wait.  Buffer interrupt output; task-context syslog and the
# panic flush drain it.
CONFIG_SYSLOG_INTBUFFER=y
CONFIG_SYSLOG_INTBUFSIZE=1024
# CONFIG_NSH_DISABLE_DATE is not set

# /dev/urandom from the hardware TRNG. DEV_URANDOM_ARCH means the arch
# supplies the whole implementation including devurandom_register()
# (chips/bk7258/bk7258_trng.c); nuttx's software PRNG compiles out. The
# ai_agent TLS stack opens /dev/urandom and refuses a predictable fallback.
CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_ARCH=y

# Run wapi on this core too. The ioctls are proxied to CP over usrsock
# (NET_USRSOCK_RPMSG), whose ioctl path already marshals the iwreq and its
# pointee when NETDEV_WIRELESS_IOCTL is set -- the same route the data
# plane takes. So connect/scan can be issued from the AP console without
# switching to CP.
CONFIG_NETDEV_WIRELESS_IOCTL=y
CONFIG_DRIVERS_WIRELESS=y

# One RPMsg buffer is 512 bytes (openamp/rpmsg_virtio.h:27) and a pointer
# ioctl carries its pointee in the request, so the scan buffer has to stay
# under one buffer: 16 (usrsock_request_ioctl_s) + 32 (iwreq) + payload
# must fit. The usrsock server only reassembles sendto fragments, so a
# split ioctl is parsed as a new request and wedges the link. Keep this
# small; the proper fix is ioctl reassembly upstream.
CONFIG_WIRELESS_WAPI_SCAN_MAX_DATA=384

# Cross-core Wi-Fi control plane (chips/bk7258/wlan_ctrl).  rpmsg_char turns
# an RPMsg endpoint into a local /dev/rpmsg-<name> on each core, so the AP
# drives scan/connect without going through usrsock -- whose request buffer
# has to fit one RPMsg message (see the note in
# chips/bk7258/wifi_armino/compat/bk7258_armino_wops.c).
CONFIG_RPMSG_CHAR=y

# The wlan-ctrl control message is 148 bytes (ssid + passphrase + one AP);
# the default MQ_MAXMSGSIZE of 32 made nxmq_alloc_msgq() assert.
CONFIG_MQ_MAXMSGSIZE=256
# --- Display and UI (moved here from the CP, as in Armino) ---
# LCD1 on the SPI1 master: GPIO2=SCK, GPIO4=MOSI, CS=GPIO3, D/C=GPIO5.
# bk7258_spi_hw.c polls the FIFO and attaches no IRQ, so it runs on either
# core; only one core may own the bus, and that is this one now.
CONFIG_BK7258_LCD1_SPI_HW=y
CONFIG_LCD_DEV=y
CONFIG_LCD_JD9853=y
CONFIG_LCD_PORTRAIT=y
# SPI1 runs from the 26 MHz XTAL; 13 MHz (clk_rate=1) is the ceiling.
CONFIG_LCD_JD9853_FREQUENCY=13000000
CONFIG_GRAPHICS_LVGL=y
CONFIG_LV_USE_NUTTX=y
CONFIG_LV_USE_NUTTX_LCD=y
CONFIG_LV_NUTTX_LCD_CUSTOM_BUFFER=y
CONFIG_LV_NUTTX_LCD_BUFFER_SIZE=40
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_LOG=y
# ponytail: four Montserrat sizes kept from the contest branch; drop the
# unused ones once the UI settles.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_EXAMPLES_LVGLDEMO=y
# Below nsh_main (100) so a running demo cannot starve the console.
CONFIG_EXAMPLES_LVGLDEMO_PRIORITY=90
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_DEMO_STRESS=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_ARCH_SETJMP_H=y
CONFIG_LIB_FREETYPE=y
CONFIG_LV_USE_FREETYPE=y
CONFIG_UIKIT=y
# Local LVGL UI channel.  ai_agent compiles its own full MiSans 16 CJK font
# (src/ui/lv_font_misans_16_cjk.c) under this symbol, so no LVGL patch is
# needed.  Replaces the contest branch's AI_AGENT_UI_RPMSG to a CP renderer.
CONFIG_AI_AGENT_LVGL_UI=y
CONFIG_AI_AGENT_PET_STATUS=y
# ai_agent f297082 rotates the idle screen between the pet and particle
# pages; with PET_STATUS alone lvgl_ui_channel.c does not compile.
CONFIG_AI_AGENT_PARTICLE_FLOW=y
# Push-to-talk on KEY3 (GPIO8) through ai_agent's ptt_button.c, which also
# drives the UI (recording/processing states, the user bubble).  Its
# defaults (button 0 = KEY1, 4 KB stack, priority 100) are wrong here:
# KEY1 answers permission prompts, voice_channel_start/stop run the ASR TLS
# handshake on this thread's stack and overflowed 4 KB (sha3.c, board log),
# and a CPU-bound ECDH handshake above bk7258-ap-health (80) starves it
# until the CP reports the AP stalled.  50 matches ai_agent's voice task.
CONFIG_AI_AGENT_PTT=y
CONFIG_AI_AGENT_PTT_BUTTON_IDX=2
CONFIG_AI_AGENT_PTT_STACKSIZE=24576
CONFIG_AI_AGENT_PTT_PRIORITY=50
# ai_agent nsh_commands calls system(3).
CONFIG_SYSTEM_SYSTEM=y
# ARMv8-M MPU, phase one (chips/bk7258/bk7258_mpuinit.c): only flash XIP is
# cached; SRAM, PSRAM and peripherals are not, matching Armino with
# CACHE_ENABLE=n.  The D-cache is re-enabled only when this is set.
CONFIG_ARM_MPU=y
CONFIG_ARM_MPU_NREGIONS=8
# bk7258_mpu_test: dumps and checks the region table, plus two fault probes.
CONFIG_BK7258_MPU_TEST=y
CONFIG_DEBUG_MEMFAULT=y

# wget as the board-initiated download client: it is the only way to
# measure the downlink direction, because the board sits behind the
# hotspot's NAT (nothing outside can open a connection to it) and its
# iperf is the NuttX example, not iperf2, so `iperf -s` resets an
# iperf2 client on the first header. nshlib forces NSH_DISABLE_WGET
# unless NETUTILS_WEBCLIENT is on (apps/nshlib/nsh.h:106-110).
CONFIG_NETUTILS_WEBCLIENT=y
# 512 B per recv would charge a cross-core request for every 512 B
# on the AP, which is not the network's cost. 4096 is the TLS record
# size the AP apps actually use and stays under one recv per read.
CONFIG_NSH_WGET_BUFF_SIZE=4096
