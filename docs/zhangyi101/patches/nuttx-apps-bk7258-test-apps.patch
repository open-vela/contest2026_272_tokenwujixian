+  mq_attr.mq_flags   = 0;
+  mq_attr.mq_curmsgs = 0;
+
+  mq_unlink(MQ_NAME);
+  mq = mq_open(MQ_NAME, O_RDWR | O_CREAT, 0644, &mq_attr);
+  if (mq == (mqd_t)-1)
+    {
