+
+  ret = ioctl(fd, AUDIOIOC_RESERVE, 0);
+  if (ret < 0)
+    {
+      fprintf(stderr, "AUDIOIOC_RESERVE failed: %d\n", errno);
+      goto cleanup;
+    }
+  printf("[bk] reserve ok\n"); fflush(stdout);
+
+  memset(&cap, 0, sizeof(cap));
+  cap.caps.ac_len            = sizeof(struct audio_caps_s);
+  cap.caps.ac_type           = AUDIO_TYPE_OUTPUT;
+  cap.caps.ac_channels       = g_channels;
+  cap.caps.ac_controls.hw[0] = g_sample_rate & 0xFFFFu;
+  cap.caps.ac_controls.b[3]  = (uint8_t)(g_sample_rate >> 16);
+  cap.caps.ac_controls.b[2]  = 16;
+  cap.caps.ac_subtype        = AUDIO_FMT_PCM;
+
+  ret = ioctl(fd, AUDIOIOC_CONFIGURE, (unsigned long)&cap);
+  if (ret < 0)
+    {
+      fprintf(stderr, "AUDIOIOC_CONFIGURE(OUTPUT) failed: %d\n", errno);
+      goto cleanup;
+    }
+  printf("[bk] cfg-out ok\n"); fflush(stdout);
+
+  ret = set_volume(fd, g_volume);
+  if (ret < 0)
+    {
+      fprintf(stderr, "set_volume failed: %d (continuing)\n", errno);
+    }
+  printf("[bk] vol ok\n"); fflush(stdout);
+
+#ifdef CONFIG_AUDIO_BK7258
+  if (g_fifo_cpu_mode)
+    {
+      static const char *const clock_name[] = {"XTAL", "APLL"};
+      struct bk7258_dac_cfg_s   dac_cfg;
+      struct bk7258_dac_stats_s snap[2][3];
+
+      /* Run both functional clock sources in one boot.  This keeps GDMA
+       * unallocated and separates a dead APLL from a dead AUDP/FPORT path
+       * without requiring another diagnostic firmware round-trip.
+       */
+
+      dac_cfg.samp_rate = (uint32_t)g_sample_rate;
+      dac_cfg.channel   = BK7258_DAC_CHL_LR;
+      dac_cfg.work_mode = BK7258_DAC_WORK_DIFFEN;
+      dac_cfg.gain      = 0;
+
+      ret = bk7258_aud_subsystem_init();
+      if (ret < 0)
+        {
+          fprintf(stderr, "[bk] FIFOCPU subsystem init failed: %d\n", ret);
+          goto cleanup;
+        }
+
+      for (int phase = 0; phase < 2; phase++)
+        {
+          /* Flush the digital FIFOs before each phase so a failed clock
+           * source cannot contaminate the following source's snapshots.
+           */
+
+          bk7258_dac_reset_data_path();
+          dac_cfg.use_apll = phase != 0;
+          ret = bk7258_dac_configure(&dac_cfg);
+          if (ret < 0)
+            {
+              fprintf(stderr, "[bk] FIFOCPU %s configure failed: %d\n",
+                      clock_name[phase], ret);
+              bk7258_dac_deinit();
+              goto cleanup;
+            }
+
+          ret = bk7258_dac_mute(false);
+          if (ret < 0)
+            {
+              fprintf(stderr, "[bk] FIFOCPU %s unmute failed: %d\n",
+                      clock_name[phase], ret);
+              bk7258_dac_deinit();
+              goto cleanup;
+            }
+
+          bk7258_dac_start();
+          bk7258_dac_get_stats(&snap[phase][0]);
+          for (int i = 0; i < 32; i++)
+            {
+              bk7258_dac_fifo_write(UINT32_C(0x12341234));
+            }
+
+          bk7258_dac_get_stats(&snap[phase][1]);
+          usleep(5000);
+          bk7258_dac_get_stats(&snap[phase][2]);
+          bk7258_dac_stop();
+        }
+
+      bk7258_dac_deinit();
+
+      for (int phase = 0; phase < 2; phase++)
+        {
+          const struct bk7258_dac_stats_s *cfg = &snap[phase][0];
+
+          printf("[bk] FIFOCPU %s ver=%08lx global=%08lx\n",
+                 clock_name[phase],
+                 (unsigned long)cfg->version_id,
+                 (unsigned long)cfg->global_status);
+          printf("[bk] FIFOCPU %s sys clk1=%08lx clk2=%08lx "
+                 "dev=%08lx pwr=%08lx spi=%08lx\n",
+                 clock_name[phase],
+                 (unsigned long)cfg->sys_clk_div_mode1,
+                 (unsigned long)cfg->sys_clk_div_mode2,
+                 (unsigned long)cfg->device_clk_enable,
+                 (unsigned long)cfg->power_sleep_wakeup,
+                 (unsigned long)cfg->analog_spi_state);
+          printf("[bk] FIFOCPU %s mem sd=%08lx ds=%08lx\n",
+                 clock_name[phase],
+                 (unsigned long)cfg->device_mem_ctrl1,
+                 (unsigned long)cfg->device_mem_ctrl2);
+          printf("[bk] FIFOCPU %s ana 5=%08lx 18=%08lx 19=%08lx "
+                 "20=%08lx 21=%08lx\n",
+                 clock_name[phase],
+                 (unsigned long)cfg->ana_reg5,
+                 (unsigned long)cfg->ana_reg18,
+                 (unsigned long)cfg->ana_reg19,
+                 (unsigned long)cfg->ana_reg20,
+                 (unsigned long)cfg->ana_reg21);
+          printf("[bk] FIFOCPU %s apll 25=%08lx 26=%08lx 27=%08lx\n",
+                 clock_name[phase],
+                 (unsigned long)cfg->ana_reg25,
+                 (unsigned long)cfg->ana_reg26,
+                 (unsigned long)cfg->ana_reg27);
+
+          for (int sample = 0; sample < 3; sample++)
+            {
+              static const char *const sample_name[] =
+                {"before", "written", "drained"};
+              const struct bk7258_dac_stats_s *st = &snap[phase][sample];
+
+              printf("[bk] FIFOCPU %s %-7s fifo=%08lx cfg=%08lx "
+                     "audio=%08lx dac=%08lx ext=%08lx clk=%08lx\n",
+                     clock_name[phase], sample_name[sample],
+                     (unsigned long)st->fifo_status,
+                     (unsigned long)st->fifo_config,
+                     (unsigned long)st->audio_config,
+                     (unsigned long)st->dac_config0,
+                     (unsigned long)st->extend_cfg,
+                     (unsigned long)st->clk_control);
+            }
+        }
+
+      fflush(stdout);
+      ret = 0;
+      goto cleanup;
+    }
+
+  if (g_mclk_mode)
+    {
+      /* Software observation route: mux I2S1_MCLK onto GPIO28 so the audio
+       * functional clock (XTAL 26 MHz vs APLL ~98.304 MHz) can be measured
+       * with a scope on the P28 pad.  This answers "is the audio clock
+       * domain actually oscillating?" independent of the known-dead
+       * FIFO/DREQ data path.
+       */
+
+      static const char *const clk_name[] = {"XTAL", "APLL"};
+      volatile uint32_t *p_gpio28_cfg =
+        (volatile uint32_t *)0x44000470u;   /* GPIO_CFG(28)       */
+      volatile uint32_t *p_func28 =
+        (volatile uint32_t *)0x440100ccu;   /* SYS_GPIO_FUNC(28)  */
+      volatile uint32_t *p_clkdiv1 =
+        (volatile uint32_t *)0x44010020u;   /* SYS_CLK_DIV_MODE1  */
+      volatile uint32_t *p_clkdiv2 =
+        (volatile uint32_t *)0x44010024u;   /* SYS_CLK_DIV_MODE2  */
+      volatile uint32_t *p_devclk =
+        (volatile uint32_t *)0x44010030u;   /* DEVICE_CLK_EN[0xc] */
+      volatile uint32_t *p_devclk2 =
+        (volatile uint32_t *)0x44010034u;   /* DEVICE_CLK_EN[0xd] */
+      struct bk7258_dac_cfg_s dac_cfg;
+
+      /* Mux GPIO28 -> I2S1_MCLK (AF2): per-pin cfg mode=DIS + second-func
+       * (bit-identical to bk7258_gpio_periph(28, 1)); SYS_GPIO_FUNC field
+       * bits[19:16] = 1. */
+      *p_gpio28_cfg = (*p_gpio28_cfg & ~UINT32_C(0x3c)) | UINT32_C(0x48);
+      *p_func28     = (*p_func28     & ~UINT32_C(0x000f0000)) |
+                      UINT32_C(0x00010000);
+
+      /* Gate on the I2S + I2S1 functional clocks. */
+      *p_devclk  |= UINT32_C(1) << 16;   /* i2s_cken  */
+      *p_devclk2 |= UINT32_C(1) << 1;    /* i2s1_cken */
+
+      dac_cfg.samp_rate = (uint32_t)g_sample_rate;
+      dac_cfg.channel   = BK7258_DAC_CHL_LR;
+      dac_cfg.work_mode = BK7258_DAC_WORK_DIFFEN;
+      dac_cfg.gain      = 0;
+
+      ret = bk7258_aud_subsystem_init();
+      if (ret < 0)
+        {
+          fprintf(stderr, "[bk] MCLK subsystem init failed: %d\n", ret);
+          goto cleanup;
+        }
+
+      for (int phase = 0; phase < 2; phase++)
+        {
+          uint32_t sel = phase != 0;
+
+          bk7258_dac_reset_data_path();
+          dac_cfg.use_apll = sel != 0;
+          ret = bk7258_dac_configure(&dac_cfg);
+          if (ret < 0)
+            {
+              fprintf(stderr, "[bk] MCLK %s configure failed: %d\n",
+                      clk_name[phase], ret);
+              bk7258_dac_deinit();
+              goto cleanup;
+            }
+
+          /* Point I2S / I2S1 MCLK at the same functional clock:
+           * cksel_i2s (bit24) + cksel_i2s1 (bit11). 0=XTAL(26M) 1=APLL. */
+          if (sel)
+            {
+              *p_clkdiv1 |= UINT32_C(1) << 24;
+              *p_clkdiv2 |= UINT32_C(1) << 11;
+            }
+          else
+            {
+              *p_clkdiv1 &= ~(UINT32_C(1) << 24);
+              *p_clkdiv2 &= ~(UINT32_C(1) << 11);
+            }
+
+          printf("[bk] MCLK phase=%s cksel_i2s=%lu cksel_i2s1=%lu "
+                 "cksel_aud=%lu clkdiv1=%08lx clkdiv2=%08lx\n",
+                 clk_name[phase],
+                 (unsigned long)((*p_clkdiv1 >> 24) & 1),
+                 (unsigned long)((*p_clkdiv2 >> 11) & 1),
+                 (unsigned long)((*p_clkdiv1 >> 25) & 1),
+                 (unsigned long)*p_clkdiv1,
+                 (unsigned long)*p_clkdiv2);
+          printf("[bk] MCLK -> measure GPIO28 (P28 pad): expect %s\n",
+                 sel ? "~98.304 MHz (APLL)" : "~26 MHz (XTAL)");
+          fflush(stdout);
+          usleep(3000000);
+        }
+
+      bk7258_dac_deinit();
+      printf("[bk] MCLK done\n"); fflush(stdout);
+      ret = 0;
+      goto cleanup;
+    }
+
+  if (g_capture_mode)
+    {
+      /* Dual-MIC capture.  Configures the ADC in dual-channel (LR) mode,
+       * starts the capture clock, then drains AUD_ADC_FPORT in a polled loop
+       * for ~1 s of frames, splitting each 32-bit stereo frame into MIC1 (L,
+       * low 16 bits) and MIC2 (R, high 16 bits).  Per-channel DC/min/max and
+       * peak-to-peak are reported so the operator can confirm both analog
+       * MICs deliver signal: a live input swings hundreds of counts
+       * (pp >> noise), a dead/missing input sits flat at its bias point.
+       * Runs both XTAL and APLL to match the -F DAC probe. */
+
+      static const char *const clk_name[] = {"XTAL", "APLL"};
+      struct bk7258_adc_cfg_s   adc_cfg;
+      struct bk7258_adc_stats_s snap[2][2];
+
+      adc_cfg.samp_rate = (uint32_t)g_sample_rate;
+      adc_cfg.channel   = BK7258_ADC_CHL_LR;
+      adc_cfg.gain      = 0x2D;
+      adc_cfg.samp_edge = false;
+
+      ret = bk7258_aud_subsystem_init();
+      if (ret < 0)
+        {
+          fprintf(stderr, "[bk] ADC subsystem init failed: %d\n", ret);
+          goto cleanup;
+        }
+
+      for (int phase = 0; phase < 2; phase++)
+        {
+          uint32_t frames = 0;
+          uint32_t starved = 0;
+          int32_t  l_min = INT16_MAX, l_max = INT16_MIN, l_dc = 0;
+          int32_t  r_min = INT16_MAX, r_max = INT16_MIN, r_dc = 0;
+          uint32_t frames_target = (uint32_t)g_sample_rate; /* ~1 s */
+
+          adc_cfg.use_apll = phase != 0;
+          ret = bk7258_adc_configure(&adc_cfg);
+          if (ret < 0)
+            {
+              fprintf(stderr, "[bk] ADC %s configure failed: %d\n",
+                      clk_name[phase], ret);
+              bk7258_adc_deinit();
+              goto cleanup;
+            }
+
+          bk7258_adc_start();
+          bk7258_adc_get_stats(&snap[phase][0]);
+
+          while (frames < frames_target)
+            {
+              uint32_t w;
+              int16_t  l;
+              int16_t  r;
+
+              if (bk7258_adc_fifo_empty())
+                {
+                  /* ~2 s of consecutive empty polls -> capture clock dead.
+                   * usleep(100) rounds up to the system tick (~1 ms), so the
+                   * old 20000-iteration bail actually took 20 s+ and made the
+                   * shell look hung; 2000 x 1 ms is a bounded ~2 s.
+                   */
+                  if (++starved > 2000)
+                    {
+                      break;
+                    }
+
+                  usleep(1000);
+                  continue;
+                }
+
+              starved = 0;
+              w = bk7258_adc_fifo_read();
+              l = (int16_t)(w & UINT32_C(0xFFFF));
+              r = (int16_t)(w >> 16);
+
+              if (l < l_min) l_min = l;
+              if (l > l_max) l_max = l;
+              l_dc += l;
+              if (r < r_min) r_min = r;
+              if (r > r_max) r_max = r;
+              r_dc += r;
+
+              frames++;
+            }
+
+          bk7258_adc_get_stats(&snap[phase][1]);
+          bk7258_adc_stop();
+
+          printf("[bk] MIC %s frames=%lu "
+                 "l[dc=%ld min=%ld max=%ld pp=%ld %s] "
+                 "r[dc=%ld min=%ld max=%ld pp=%ld %s]\n",
+                 clk_name[phase], (unsigned long)frames,
+                 (long)(frames ? l_dc / (int32_t)frames : 0),
+                 (long)l_min, (long)l_max,
+                 (long)(frames ? (l_max - l_min) : 0),
+                 (frames && (l_max - l_min) >= 200) ? "LIVE" : "FLAT?",
+                 (long)(frames ? r_dc / (int32_t)frames : 0),
+                 (long)r_min, (long)r_max,
+                 (long)(frames ? (r_max - r_min) : 0),
+                 (frames && (r_max - r_min) >= 200) ? "LIVE" : "FLAT?");
+          printf("[bk] ADC %s st0 audio=%08lx adc0=%08lx fifo_cfg=%08lx "
+                 "fifo_st=%08lx\n",
+                 clk_name[phase],
+                 (unsigned long)snap[phase][0].audio_config,
+                 (unsigned long)snap[phase][0].adc_config0,
+                 (unsigned long)snap[phase][0].fifo_config,
+                 (unsigned long)snap[phase][0].fifo_status);
+          printf("[bk] ADC %s st1 fifo_st=%08lx ext=%08lx clk=%08lx "
+                 "clk1=%08lx clk2=%08lx dev=%08lx ana18=%08lx ana19=%08lx\n",
+                 clk_name[phase],
+                 (unsigned long)snap[phase][1].fifo_status,
+                 (unsigned long)snap[phase][1].extend_cfg,
+                 (unsigned long)snap[phase][1].clk_control,
+                 (unsigned long)snap[phase][1].sys_clk_div_mode1,
+                 (unsigned long)snap[phase][1].sys_clk_div_mode2,
+                 (unsigned long)snap[phase][1].device_clk_enable,
+                 (unsigned long)snap[phase][1].ana_reg18,
+                 (unsigned long)snap[phase][1].ana_reg19);
+        }
+
+      bk7258_adc_deinit();
+      fflush(stdout);
+      ret = 0;
+      goto cleanup;
+    }
+
+  if (g_loop_mode)
+    {
+      /* DTMF -> DAC loopback probe.  loop_ton2dac routes the on-chip DTMF
+       * tone generator straight into the DAC with no host FPORT write.  If a
+       * tone is audible, the DAC analog path + functional clock are alive and
+       * the fault is purely in how we feed DAC_FPORT (CPU/GDMA).  If silent,
+       * the clock/analog bring-up is the fault.  DTMF registers are poked
+       * bare here (same style as the FPORT-KICK probe) because there is no
+       * DTMF HAL yet. */
+
+      volatile uint32_t *p_dtmf_cfg0 = (volatile uint32_t *)0x478000c4u;
+      volatile uint32_t *p_dtmf_cfg1 = (volatile uint32_t *)0x478000c8u;
+      volatile uint32_t *p_dtmf_cfg2 = (volatile uint32_t *)0x478000ccu;
+      volatile uint32_t *p_audio_cfg = (volatile uint32_t *)0x478000c0u;
+      struct bk7258_dac_cfg_s dac_cfg;
+
+      dac_cfg.samp_rate = (uint32_t)g_sample_rate;
+      dac_cfg.channel   = BK7258_DAC_CHL_LR;
+      dac_cfg.work_mode = BK7258_DAC_WORK_DIFFEN;
+      dac_cfg.gain      = 0;
+      dac_cfg.use_apll  = false;
+
+      ret = bk7258_aud_subsystem_init();
+      if (ret < 0)
+        {
+          fprintf(stderr, "[bk] LOOP subsystem init failed: %d\n", ret);
+          goto cleanup;
+        }
+
+      ret = bk7258_dac_configure(&dac_cfg);
+      if (ret < 0)
+        {
+          fprintf(stderr, "[bk] LOOP dac configure failed: %d\n", ret);
+          goto cleanup;
+        }
+
+      ret = bk7258_dac_mute(false);
+      if (ret < 0)
+        {
+          fprintf(stderr, "[bk] LOOP unmute failed: %d\n", ret);
+          bk7258_dac_deinit();
+          goto cleanup;
+        }
+
+      bk7258_dac_start();
+
+      /* Program the DTMF tone generator: 1 kHz continuous tone.
+       * tone1_step = F(kHz) * 8191, so 8191 = 1 kHz. */
+      *p_dtmf_cfg0 = (0u << 0)      /* tone_pattern: DTMF          */
+                   | (1u << 1)      /* tone_mode: continuous       */
+                   | (15u << 2)     /* tone_pause_time: 150 ms     */
+                   | (15u << 6);    /* tone_active_time: 150 ms    */
+      *p_dtmf_cfg1 = (8191u << 0)   /* tone1_step: 1 kHz           */
+                   | (0u << 16)     /* tone1_attu: -1 dB           */
+                   | (1u << 20);    /* tone1_enable                */
+      *p_dtmf_cfg2 = (8191u << 0)   /* tone2_step: 1 kHz           */
+                   | (0u << 16)     /* tone2_attu                   */
+                   | (0u << 20);    /* tone2_enable: off           */
+
+      /* dtmf_enable (audio_config bit4), then loop_ton2dac (fifo_config
+       * bit24). */
+      *p_audio_cfg |= (1u << 4);
+      bk7258_aud_loop_ton2dac(true);
+
+      printf("[bk] LOOP ton2dac ON — expect a 1 kHz tone for ~3 s\n");
+      fflush(stdout);
+      usleep(3000000);
+
+      bk7258_aud_loop_ton2dac(false);
+      *p_audio_cfg &= ~(1u << 4);
+      bk7258_dac_stop();
+      bk7258_dac_deinit();
+
+      printf("[bk] LOOP done\n"); fflush(stdout);
+      ret = 0;
+      goto cleanup;
+    }
+#else
+  if (g_fifo_cpu_mode)
+    {
+      fprintf(stderr, "-F requires CONFIG_AUDIO_BK7258\n");
+      ret = -ENOSYS;
+      goto cleanup;
+    }
+  if (g_mclk_mode)
+    {
+      fprintf(stderr, "-M requires CONFIG_AUDIO_BK7258\n");
+      ret = -ENOSYS;
+      goto cleanup;
+    }
+  if (g_capture_mode)
+    {
+      fprintf(stderr, "-C requires CONFIG_AUDIO_BK7258\n");
+      ret = -ENOSYS;
+      goto cleanup;
+    }
+  if (g_loop_mode)
+    {
+      fprintf(stderr, "-L requires CONFIG_AUDIO_BK7258\n");
+      ret = -ENOSYS;
+      goto cleanup;
+    }
+#endif
+
+  ret = ioctl(fd, AUDIOIOC_REGISTERMQ, (unsigned long)mq);
+  if (ret < 0)
+    {
+      fprintf(stderr, "AUDIOIOC_REGISTERMQ failed: %d\n", errno);
+      goto cleanup;
+    }
+  printf("[bk] regmq ok\n"); fflush(stdout);
+
+  ret = ioctl(fd, AUDIOIOC_GETBUFFERINFO, (unsigned long)&buf_info);
+  if (ret < 0)
+    {
+      buf_info.buffer_size = 4096;
+      buf_info.nbuffers    = 4;
+    }
+  printf("[bk] bufinfo n=%u sz=%u\n",
+         (unsigned)buf_info.nbuffers, (unsigned)buf_info.buffer_size);
+  fflush(stdout);
+
+  total_bytes = (size_t)((int64_t)g_sample_rate * g_channels
+                         * 2 * g_duration_ms / 1000);
+
+  /* Prime the driver with N buffers and then keep it topped up until we
+   * have queued total_bytes worth of samples, tagging the last buffer
+   * with AUDIO_APB_FINAL so the driver signals COMPLETE.
+   */
+
+  for (int i = 0; i < buf_info.nbuffers; i++)
+    {
+      buf_desc.numbytes  = buf_info.buffer_size;
+      buf_desc.u.pbuffer = &apb;
+      ret = ioctl(fd, AUDIOIOC_ALLOCBUFFER, (unsigned long)&buf_desc);
+      if (ret != sizeof(buf_desc) || apb == NULL)
+        {
+          fprintf(stderr, "AUDIOIOC_ALLOCBUFFER failed: %d\n", errno);
+          goto cleanup;
+        }
+
+      size_t chunk = buf_info.buffer_size;
+      if (bytes_written + chunk >= total_bytes)
+        {
+          chunk = total_bytes - bytes_written;
+          apb->flags |= AUDIO_APB_FINAL;
+        }
+
+      fill_sine((FAR int16_t *)apb->samp, chunk / 2, &phase_accum);
+      apb->nbytes    = chunk;
+      apb->curbyte   = 0;
+      apb->nmaxbytes = buf_info.buffer_size;
+      bytes_written += chunk;
+
+      buf_desc.u.buffer = apb;
+      ret = ioctl(fd, AUDIOIOC_ENQUEUEBUFFER, (unsigned long)&buf_desc);
+      if (ret < 0)
+        {
+          fprintf(stderr, "AUDIOIOC_ENQUEUEBUFFER failed: %d\n", errno);
+          goto cleanup;
+        }
+      printf("[bk] enq %d\n", i); fflush(stdout);
+
+      if (bytes_written >= total_bytes)
+        {
+          break;
+        }
+    }
+
+  ret = ioctl(fd, AUDIOIOC_START, 0);
+  if (ret < 0)
+    {
+      fprintf(stderr, "AUDIOIOC_START failed: %d\n", errno);
+      goto cleanup;
+    }
+  printf("[bk] start ok, waiting for COMPLETE\n"); fflush(stdout);
+
+#ifdef CONFIG_AUDIO_BK7258
+  /* Decisive audio-bus probe.  The -F trace already showed that 32 CPU
+   * writes to DAC_FPORT leave FIFO_STATUS unchanged (EMPTY bits stay 1).
+   * This probe isolates WHY by testing three independent questions with
+   * bare volatile pointers (same style as the RAW ana-reg probe below, so
+   * it needs no extra includes):
+   *
+   *  (A) Does a write to a readable audio register commit?  We write a
+   *      magic value into DAC_CONFIG0 (0x4780001c, R/W, readback-able) and
+   *      read it back.  Readback == magic => the AP CPU CAN commit writes
+   *      to the audio register bank, so the FPORT failure is specific to
+   *      the FIFO data port, not a global bus/clock/secure gate.
+   *
+   *  (B) Do ANY of the four FIFO ports accept data?  We push one word to
+   *      DTMF/ADC/DAC/DMIC FPORT in turn and read FIFO_STATUS after each.
+   *      FIFO_STATUS has separate EMPTY bits per FIFO (DTMF=15, ADCL=14,
+   *      DACR=12, DACL=13, DMIC=23).  If the matching EMPTY bit clears for
+   *      any port, that FIFO is alive; if NONE clears, the whole FIFO
+   *      write path is dead (clock/gate/reset at the FIFO subsystem level).
+   *
+   *  (C) Does DAC_ENABLE gate the FPORT write?  We write DAC_FPORT with
+   *      DAC_ENABLE=1, record status, then clear DAC_ENABLE and write
+   *      again.  If status is identical either way, ENABLE does not gate
+   *      the FIFO input — pointing at the FIFO subsystem, not the DAC.
+   */
+  if (g_trace_mode || g_fifo_cpu_mode)
+    {
+      volatile uint32_t *p_audio_cfg  = (volatile uint32_t *)0x478000c0u;
+      volatile uint32_t *p_dac_cfg0    = (volatile uint32_t *)0x4780001cu;
+      volatile uint32_t *p_fifo_status = (volatile uint32_t *)0x47800038u;
+      volatile uint32_t *p_dtmf_fport  = (volatile uint32_t *)0x47800040u;
+      volatile uint32_t *p_adc_fport   = (volatile uint32_t *)0x47800044u;
+      volatile uint32_t *p_dac_fport   = (volatile uint32_t *)0x47800048u;
+      struct bk7258_dac_stats_s ps;
+      /* bit30-31 of DAC_CONFIG0 are RESERVED (hardware forces them to 0), so
+       * the magic stays within bit0-29 to make readback == magic meaningful.
+       * An impossible HPF2 coef + gain + notchen pattern that the running
+       * config would never have. */
+      uint32_t magic = UINT32_C(0x1A3C6901);
+      uint32_t cfg0_orig;
+      uint32_t cfg0_rb;
+      uint32_t ac_orig;
+      uint32_t fs_pre;
+      uint32_t fs_dtmf;
+      uint32_t fs_adc;
+      uint32_t fs_dac_en1;
+      uint32_t fs_dac_en0;
+      uint32_t ac_after;
+
+      bk7258_dac_get_stats(&ps);
+      printf("[bk] FPORT-KICK pre  audio=%08lx fifo_cfg=%08lx fifo_st=%08lx "
+             "dac_cfg0=%08lx clk=%08lx ext=%08lx\n",
+             (unsigned long)ps.audio_config, (unsigned long)ps.fifo_config,
+             (unsigned long)ps.fifo_status, (unsigned long)ps.dac_config0,
+             (unsigned long)ps.clk_control, (unsigned long)ps.extend_cfg);
+
+      /* Dump the analog-side audio enable state.  AVDK's CP
+       * sys_hal_power_config_default() clears ana_reg25.audioen (bit31)
+       * and test_ckaudio_en (bit20) at boot; the audio driver's PM vote
+       * is what puts them back.  ana_reg25 is also the APLL config reg,
+       * so BK7258_APLL_CONFIG_VAL 0xC2A0AE86 carries audioen=1 as a
+       * side effect of APLL programming — but only if the SPI trigger
+       * pulse actually loaded it.  reg5 bit13 = PWDAUDPLL (0=powered).
+       * reg23 bit31 = a second audioen field.  Read all three raw.
+       */
+        {
+          volatile uint32_t *p5   = (volatile uint32_t *)0x44010114u;
+          volatile uint32_t *p23  = (volatile uint32_t *)0x4401015cu;
+          volatile uint32_t *p25  = (volatile uint32_t *)0x44010164u;
+          volatile uint32_t *pspi = (volatile uint32_t *)0x440100e8u;
+          uint32_t v5  = *p5;
+          uint32_t v23 = *p23;
+          uint32_t v25 = *p25;
+          printf("[bk] FPORT-KICK ana  r5=%08lx(apll_pwr=%lu) "
+                 "r23=%08lx(aud_en=%lu) r25=%08lx(aud_en=%lu "
+                 "spi_trig=%lu ckaudio=%lu) spi_state=%08lx\n",
+                 (unsigned long)v5,  (unsigned long)((v5 >> 13) & 1),
+                 (unsigned long)v23, (unsigned long)((v23 >> 31) & 1),
+                 (unsigned long)v25, (unsigned long)((v25 >> 31) & 1),
+                 (unsigned long)((v25 >> 18) & 1),
+                 (unsigned long)((v25 >> 20) & 1),
+                 (unsigned long)*pspi);
+        }
+
+      /* (A) write/read DAC_CONFIG0 — is the audio write bus alive? */
+      cfg0_orig = *p_dac_cfg0;
+      *p_dac_cfg0 = magic;
+      up_udelay(2);
+      cfg0_rb = *p_dac_cfg0;
+      *p_dac_cfg0 = cfg0_orig;           /* restore */
+      up_udelay(2);
+      printf("[bk] FPORT-KICK (A) DAC_CFG0 wr=%08lx rd=%08lx orig=%08lx "
+             "%s\n",
+             (unsigned long)magic, (unsigned long)cfg0_rb,
+             (unsigned long)cfg0_orig,
+             (cfg0_rb == magic) ? "WRITEBUS_OK" : "WRITEBUS_DEAD");
+
+      /* (B) push one word to each FPORT, read FIFO_STATUS after each.
+       *     EMPTY bits: DTMF=15 ADCL=14 DACL=13 DACR=12 DMIC=23. */
+      fs_pre = *p_fifo_status;
+      *p_dtmf_fport = UINT32_C(0x00010001);
+      up_udelay(2);
+      fs_dtmf = *p_fifo_status;
+      *p_adc_fport  = UINT32_C(0x00010001);
+      up_udelay(2);
+      fs_adc = *p_fifo_status;
+      *p_dac_fport  = UINT32_C(0x00010001);
+      up_udelay(2);
+      fs_dac_en1 = *p_fifo_status;
+      printf("[bk] FPORT-KICK (B) fifo_st pre=%08lx dtmf=%08lx adc=%08lx "
+             "dac=%08lx\n", (unsigned long)fs_pre, (unsigned long)fs_dtmf,
+             (unsigned long)fs_adc, (unsigned long)fs_dac_en1);
+      printf("[bk] FPORT-KICK (B) dtmf_empty_chg=%lu adcl_empty_chg=%lu "
+             "dacl_empty_chg=%lu dacr_empty_chg=%lu dmic_empty_chg=%lu\n",
+             (unsigned long)(((fs_pre ^ fs_dtmf) >> 15) & 1),
+             (unsigned long)(((fs_pre ^ fs_dtmf) >> 14) & 1),
+             (unsigned long)(((fs_pre ^ fs_dac_en1) >> 13) & 1),
+             (unsigned long)(((fs_pre ^ fs_dac_en1) >> 12) & 1),
+             (unsigned long)0);
+
+      /* (C) does DAC_ENABLE gate the FPORT?  Clear ENABLE, write, status. */
+      ac_orig = *p_audio_cfg;
+      *p_audio_cfg = ac_orig & ~UINT32_C(0x4);   /* clear DAC_ENABLE bit2 */
+      up_udelay(2);
+      *p_dac_fport  = UINT32_C(0x00010001);
+      up_udelay(2);
+      fs_dac_en0 = *p_fifo_status;
+      *p_audio_cfg = ac_orig;                    /* restore ENABLE */
+      up_udelay(2);
+      ac_after = *p_audio_cfg;
+      printf("[bk] FPORT-KICK (C) dac_en1_st=%08lx dac_en0_st=%08lx "
+             "(same=%d) audio_orig=%08lx restored=%08lx\n",
+             (unsigned long)fs_dac_en1, (unsigned long)fs_dac_en0,
+             (int)(fs_dac_en1 == fs_dac_en0),
+             (unsigned long)ac_orig, (unsigned long)ac_after);
+
+      /* 10x rapid DAC FPORT writes with per-write status sample — catches
+       * a momentarily-cleared EMPTY if the DAC drains within microseconds. */
+      for (int k = 0; k < 10; k++)
+        {
+          uint32_t s0 = *p_fifo_status;
+          *p_dac_fport = UINT32_C(0x00010001);
+          uint32_t s1 = *p_fifo_status;
+          printf("[bk] FPORT-KICK  wr%-2d st_before=%08lx st_after=%08lx "
+                 "(L_empty=%lu R_empty=%lu)\n",
+                 k, (unsigned long)s0, (unsigned long)s1,
+                 (unsigned long)((s1 >> 13) & 1),
+                 (unsigned long)((s1 >> 12) & 1));
+          usleep(1);
+        }
+      fflush(stdout);
+    }
+
+  if (g_trace_mode)
+    {
+      /* Sample the DMA + audio-block state every 5 ms, 40 times.  This
+       * tells us whether:
+       *  - remain_len is truly frozen or slowly decrementing
+       *  - fifo_status oscillates (DAC drains + DMA refills) or is static
+       *  - the GDMA ISR ever fires (isr_count > 0)
+       */
+
+      struct bk7258_gdma_stats_s gs;
+      struct bk7258_dac_stats_s  ds;
+
+      /* RAW analog-register write/read probe — bypasses every helper in
+       * bk7258_dac.c so we can decide, independent of the DAC HAL, whether
+       * the AP CPU can write the analog register file at all.  We pick a
+       * magic value that cannot appear by chance, write it to ana_reg20
+       * (the DAC analog config), and read it back.  Readback == magic means
+       * analog writes work and the DAC HAL's address math is the only
+       * suspect; readback == 0 or stale means the AP cannot commit analog
+       * writes (power/clock/secure gating on this core).
+       */
+
+      {
+        /* Raw analog-reg probe.  Addresses (ana_reg0 base = 0x44010100):
+         *   ana_reg5  (APLL power, bit13=pwdaudpll) = 0x44010114
+         *   ana_reg25 (APLL config)                 = 0x44010164
+         *   ana_reg26 (APLL cal)                     = 0x44010168
+         *   SPI state                                = 0x440100e8
+         * Hard-coded to avoid pulling bk7258_internal.h into user space.
+         *
+         * This test: (1) confirm analog writes commit (write magic to
+         * reg25, read back).  (2) the real question — does clearing reg5
+         * bit13 (power UP the APLL) stick?  bk7258_apll_program does this
+         * via a RMW but the -F trace shows reg5 bit13 still =1 after the
+         * APLL phase, so the DAC has no clock and DREQ never asserts.
+         */
+        volatile uint32_t *p5   = (volatile uint32_t *)0x44010114u;
+        volatile uint32_t *p25  = (volatile uint32_t *)0x44010164u;
+        volatile uint32_t *p26  = (volatile uint32_t *)0x44010168u;
+        volatile uint32_t *spi  = (volatile uint32_t *)0x440100e8u;
+        uint32_t r5b  = *p5;
+        uint32_t r25b = *p25;
+        uint32_t magic = UINT32_C(0xDEADBEEF);
+        uint32_t r5_after_clr;
+        uint32_t r25_rd;
+
+        /* (1) plain write to reg25, read back, then RESTORE so the
+         * APLL config + audioen bits survive the rest of the trace.
+         * The earlier build left reg25=DEADBEEF, which clobbered the
+         * APLL config and made the 40-sample trace run with a broken
+         * APLL. */
+        *p25 = magic;
+        up_udelay(50);
+        r25_rd = *p25;
+        *p25 = r25b;                      /* restore APLL config + audioen */
+        up_udelay(50);
+
+        /* (2) RMW reg5 bit13 -> 0 (power up APLL) */
+        *p5 = r5b & ~(UINT32_C(1) << 13);
+        up_udelay(50);
+        r5_after_clr = *p5;
+
+        printf("[bk] PROBE r5 before=%08lx clr13->%08lx (bit13=%lu) "
+               "r25 wr=%08lx rd=%08lx r25_orig=%08lx restored=%08lx "
+               "spi=%08lx r26=%08lx\n",
+               (unsigned long)r5b, (unsigned long)r5_after_clr,
+               (unsigned long)((r5_after_clr >> 13) & 1),
+               (unsigned long)magic, (unsigned long)r25_rd,
+               (unsigned long)r25b, (unsigned long)*p25,
+               (unsigned long)*spi, (unsigned long)*p26);
+        fflush(stdout);
+      }
+
+      bk7258_gdma_get_stats(&gs);
+      printf("[bk] TRACE cfg req=%08lx src_loop=%08lx-%08lx\n",
+             (unsigned long)gs.ch[0].reqmux,
+             (unsigned long)gs.ch[0].src_loop_start,
+             (unsigned long)gs.ch[0].src_loop_end);
+      printf("[bk] TRACE cfg dst_loop=%08lx-%08lx\n",
+             (unsigned long)gs.ch[0].dst_loop_start,
+             (unsigned long)gs.ch[0].dst_loop_end);
+      printf("[bk] TRACE t(ms) remain st     src_rd dst_wr ctrl prio\n");
+      printf("[bk] TRACE       fifo_st fifo_cfg audio_cfg ist0 ist_alc isr fin err\n");
+      for (int t = 0; t < 40; t++)
+        {
+          bk7258_gdma_get_stats(&gs);
+          bk7258_dac_get_stats(&ds);
+          uint32_t remain = gs.ch[0].status & 0x1FFFFu;
+          printf("  %3d %5lu %08lx %08lx %08lx %08lx %08lx\n",
+                 t * 5,
+                 (unsigned long)remain,
+                 (unsigned long)gs.ch[0].status,
+                 (unsigned long)gs.ch[0].src,
+                 (unsigned long)gs.ch[0].dst,
+                 (unsigned long)gs.ch[0].ctrl,
+                 (unsigned long)gs.prio_mode);
+          printf("      %08lx %08lx %08lx %08lx %08lx %3lu %3lu %3lu\n",
+                 (unsigned long)ds.fifo_status,
+                 (unsigned long)ds.fifo_config,
+                 (unsigned long)ds.audio_config,
+                 (unsigned long)gs.int_status0,
+                 (unsigned long)gs.int_allocate,
+                 (unsigned long)gs.isr_count,
+                 (unsigned long)gs.finish_count,
+                 (unsigned long)gs.buserr_count);
+          fflush(stdout);
+          usleep(5000);
+        }
+
+      (void)ioctl(fd, AUDIOIOC_STOP, 0);
+      goto cleanup;
+    }
+#endif
+
+  /* Drive the queue until COMPLETE. */
+
+  bool done = false;
+  int timeout_count = 0;
+  while (!done)
+    {
+      struct timespec abs_to;
+      clock_gettime(CLOCK_REALTIME, &abs_to);
+      abs_to.tv_sec += 2;
+      msglen = mq_timedreceive(mq, (FAR char *)&msg, sizeof(msg), &prio,
+                               &abs_to);
+      if (msglen < 0 && errno == ETIMEDOUT)
+        {
+          timeout_count++;
+          fprintf(stderr, "[bk] timeout %d, dumping GDMA state\n",
+                  timeout_count);
+#ifdef CONFIG_AUDIO_BK7258
+          {
+            struct bk7258_gdma_stats_s st;
+            bk7258_gdma_get_stats(&st);
+            printf("  isr=%lu fin=%lu half=%lu err=%lu\n",
+                   (unsigned long)st.isr_count,
+                   (unsigned long)st.finish_count,
+                   (unsigned long)st.half_count,
+                   (unsigned long)st.buserr_count);
+            printf("  cpu_int_en @0x%08lx = 0x%08lx (bit11 must be 1)\n",
+                   (unsigned long)st.cpu_int_en_reg,
+                   (unsigned long)st.cpu_int_en_val);
+            printf("  dev_clk_en = 0x%08lx (bit16 must be 1)\n",
+                   (unsigned long)st.dev_clk_en_val);
+            printf("  prio_mode=0x%08lx int_st0=0x%08lx int_alloc=0x%08lx\n",
+                   (unsigned long)st.prio_mode,
+                   (unsigned long)st.int_status0,
+                   (unsigned long)st.int_allocate);
+            for (int ci = 0; ci < 8; ci++)
+              {
+                if (st.ch[ci].ctrl == 0 && !st.ch[ci].in_use)
+                  {
+                    continue;
+                  }
+                printf("  ch%d: ctrl=%08lx st=%08lx src=%08lx dst=%08lx "
+                       "req=%08lx use=%u\n", ci,
+                       (unsigned long)st.ch[ci].ctrl,
+                       (unsigned long)st.ch[ci].status,
+                       (unsigned long)st.ch[ci].src,
+                       (unsigned long)st.ch[ci].dst,
+                       (unsigned long)st.ch[ci].reqmux,
+                       (unsigned)st.ch[ci].in_use);
+              }
+
+            struct bk7258_dac_stats_s ds;
+            bk7258_dac_get_stats(&ds);
+            printf("  DAC: audio_cfg=%08lx fifo_cfg=%08lx fifo_st=%08lx\n",
+                   (unsigned long)ds.audio_config,
+                   (unsigned long)ds.fifo_config,
+                   (unsigned long)ds.fifo_status);
+            printf("       dac_cfg0=%08lx extend=%08lx clk_ctrl=%08lx\n",
+                   (unsigned long)ds.dac_config0,
+                   (unsigned long)ds.extend_cfg,
+                   (unsigned long)ds.clk_control);
+          }
+#endif
+          if (timeout_count >= 3)
+            {
+              fprintf(stderr, "[bk] giving up\n");
+              break;
+            }
+          continue;
+        }
+
+      if (msglen < (ssize_t)sizeof(msg))
+        {
+          fprintf(stderr, "mq_receive failed: %d\n", errno);
+          break;
+        }
+
+      switch (msg.msg_id)
+        {
+          case AUDIO_MSG_DEQUEUE:
+            printf("[bk] deq\n"); fflush(stdout);
+            apb = (FAR struct ap_buffer_s *)msg.u.ptr;
+
+            if (bytes_written < total_bytes)
+              {
+                size_t chunk = buf_info.buffer_size;
+                if (bytes_written + chunk >= total_bytes)
+                  {
+                    chunk = total_bytes - bytes_written;
+                    apb->flags |= AUDIO_APB_FINAL;
+                  }
+
+                fill_sine((FAR int16_t *)apb->samp, chunk / 2, &phase_accum);
+                apb->nbytes  = chunk;
+                apb->curbyte = 0;
+                bytes_written += chunk;
+
+                buf_desc.u.buffer = apb;
+                (void)ioctl(fd, AUDIOIOC_ENQUEUEBUFFER,
+                            (unsigned long)&buf_desc);
+              }
+            else
+              {
+                buf_desc.u.buffer = apb;
+                (void)ioctl(fd, AUDIOIOC_FREEBUFFER,
+                            (unsigned long)&buf_desc);
+              }
+            break;
+
+          case AUDIO_MSG_COMPLETE:
+            printf("[bk] complete\n"); fflush(stdout);
+            done = true;
+            break;
+
+          case AUDIO_MSG_UNDERRUN:
+            fprintf(stderr, "underrun\n");
+            break;
+
+          case AUDIO_MSG_IOERR:
+            fprintf(stderr, "io error\n");
+            done = true;
+            break;
+
+          default:
+            printf("[bk] msg id=%u\n", msg.msg_id); fflush(stdout);
+            break;
+        }
+    }
+
+  (void)ioctl(fd, AUDIOIOC_STOP, 0);
+  printf("[bk] stop ok\n"); fflush(stdout);
+
+cleanup:
+  (void)ioctl(fd, AUDIOIOC_UNREGISTERMQ, (unsigned long)mq);
+  (void)ioctl(fd, AUDIOIOC_RELEASE, 0);
+  mq_close(mq);
+  mq_unlink(MQ_NAME);
+  close(fd);
+  return (ret < 0) ? EXIT_FAILURE : EXIT_SUCCESS;
+}
