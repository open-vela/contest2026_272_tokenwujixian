diff --git a/testing/bk7258_btn/bk7258_btn_main.c b/testing/bk7258_btn/bk7258_btn_main.c
new file mode 100644
index 000000000..fafc7a3b1
--- /dev/null
+++ b/testing/bk7258_btn/bk7258_btn_main.c
@@ -0,0 +1,277 @@
+/****************************************************************************
+ * apps/testing/bk7258_btn/bk7258_btn_main.c
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <poll.h>
+#include <time.h>
+#include <sys/ioctl.h>
+
+#include <nuttx/input/buttons.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#ifndef CONFIG_TESTING_BK7258_BTN_DEVPATH
+#  define CONFIG_TESTING_BK7258_BTN_DEVPATH "/dev/btn0"
+#endif
+
+#ifndef CONFIG_TESTING_BK7258_BTN_LONG_MS
+#  define CONFIG_TESTING_BK7258_BTN_LONG_MS 800
+#endif
+
+#define BTN_MAX_BITS 32
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+/* Long-press threshold, in ms.  Overridable with -t <ms> at runtime. */
+
+static int g_long_ms = CONFIG_TESTING_BK7258_BTN_LONG_MS;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* Monotonic-ish millisecond timestamp.  CLOCK_MONOTONIC is not enabled on
+ * this board, so CLOCK_REALTIME is used; only differences matter here and
+ * the epoch never changes at runtime, so it is safe for this purpose.
+ */
+
+static int64_t now_ms(void)
+{
+  struct timespec ts;
+
+  clock_gettime(CLOCK_REALTIME, &ts);
+  return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static const char *btn_name(unsigned int idx)
+{
+  switch (idx)
+    {
+      case 0:
+        return "KEY1";
+      case 1:
+        return "KEY2";
+      case 2:
+        return "KEY3";
+      default:
+        return "KEY?";
+    }
+}
+
+/* Dispatch hooks.  These are the only two places the business application
+ * needs to wire into; today they just print.  A "trigger-on-hold" policy
+ * (act as soon as the threshold is crossed, while still held) would instead
+ * replace the blocking poll() with a timed poll() to the next threshold.
+ */
+
+static void on_short_press(unsigned int idx, int64_t dur_ms)
+{
+  printf("btn0: %s short press (%lld ms)\n",
+         btn_name(idx), (long long)dur_ms);
+}
+
+static void on_long_press(unsigned int idx, int64_t dur_ms)
+{
+  printf("btn0: %s long press (%lld ms)\n",
+         btn_name(idx), (long long)dur_ms);
+}
+
+static void usage(FAR const char *prog)
+{
+  printf("Usage: %s [-t <long_ms>]\n", prog);
+  printf("  -t <ms>  long-press threshold (default %d ms)\n",
+         CONFIG_TESTING_BK7258_BTN_LONG_MS);
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int main(int argc, FAR char *argv[])
+{
+  FAR const char *devpath = CONFIG_TESTING_BK7258_BTN_DEVPATH;
+  struct btn_pollevents_s pe;
+  struct pollfd pfd;
+  btn_buttonset_t supported;
+  btn_buttonset_t last;
+  bool have_baseline;
+  int64_t press_ms[BTN_MAX_BITS];
+  bool pressed[BTN_MAX_BITS];
+  unsigned int i;
+  int fd;
+  int option;
+
+  /* Parse options. */
+
+  while ((option = getopt(argc, argv, "t:h")) != ERROR)
+    {
+      switch (option)
+        {
+          case 't':
+            g_long_ms = atoi(optarg);
+            if (g_long_ms <= 0)
+              {
+                g_long_ms = CONFIG_TESTING_BK7258_BTN_LONG_MS;
+              }
+            break;
+
+          case 'h':
+          default:
+            usage(argv[0]);
+            return 0;
+        }
+    }
+
+  fd = open(devpath, O_RDONLY);
+  if (fd < 0)
+    {
+      printf("btn0: open %s failed: %d\n", devpath, errno);
+      return 1;
+    }
+
+  supported = 0;
+  if (ioctl(fd, BTNIOC_SUPPORTED, (unsigned long)&supported) < 0)
+    {
+      printf("btn0: BTNIOC_SUPPORTED failed: %d\n", errno);
+      close(fd);
+      return 1;
+    }
+
+  if (supported == 0)
+    {
+      printf("btn0: no buttons supported\n");
+      close(fd);
+      return 1;
+    }
+
+  /* Ask to wake on both press and release edges (already the default). */
+
+  pe.bp_press   = supported;
+  pe.bp_release = supported;
+  (void)ioctl(fd, BTNIOC_POLLEVENTS, (unsigned long)&pe);
+
+  printf("btn0: watching buttons 0x%08lx, long-press threshold %d ms\n",
+         (unsigned long)supported, g_long_ms);
+  printf("btn0: press/release KEY1..KEY3 to see short/long classification\n");
+
+  pfd.fd     = fd;
+  pfd.events = POLLIN;
+
+  memset(pressed, 0, sizeof(pressed));
+  have_baseline = false;
+  last = 0;
+
+  while (true)
+    {
+      btn_buttonset_t cur;
+      btn_buttonset_t change;
+      btn_buttonset_t press;
+      btn_buttonset_t release;
+      ssize_t nread;
+      int64_t now;
+
+      if (poll(&pfd, 1, -1) < 0)
+        {
+          if (errno == EINTR)
+            {
+              continue;
+            }
+
+          printf("btn0: poll failed: %d\n", errno);
+          break;
+        }
+
+      if ((pfd.revents & POLLIN) == 0)
+        {
+          continue;
+        }
+
+      nread = read(fd, &cur, sizeof(cur));
+      if (nread != (ssize_t)sizeof(cur))
+        {
+          continue;
+        }
+
+      /* First read only establishes the baseline state. */
+
+      if (!have_baseline)
+        {
+          last = cur;
+          have_baseline = true;
+          continue;
+        }
+
+      /* Compute press/release edges against our own last sample.  bit=1
+       * means "pressed" (the buttons are active-low with pull-ups).
+       */
+
+      change  = cur ^ last;
+      press   = change & cur;
+      release = change & ~cur;
+      last    = cur;
+
+      now = now_ms();
+      for (i = 0; i < BTN_MAX_BITS; i++)
+        {
+          btn_buttonset_t bit = (btn_buttonset_t)1 << i;
+
+          if ((press & bit) != 0)
+            {
+              pressed[i]  = true;
+              press_ms[i] = now;
+              printf("btn0: %s pressed\n", btn_name(i));
+            }
+          else if ((release & bit) != 0)
+            {
+              int64_t dur = now - press_ms[i];
+
+              pressed[i] = false;
+              if (dur >= g_long_ms)
+                {
+                  on_long_press(i, dur);
+                }
+              else
+                {
+                  on_short_press(i, dur);
+                }
+            }
+        }
+    }
+
+  close(fd);
+  return 0;
+}
