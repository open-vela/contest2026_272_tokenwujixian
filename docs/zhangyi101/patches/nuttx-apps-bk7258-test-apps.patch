diff --git a/testing/bk7258_pcm/bk7258_pcm_main.c b/testing/bk7258_pcm/bk7258_pcm_main.c
new file mode 100644
index 000000000..2a519bcd9
--- /dev/null
+++ b/testing/bk7258_pcm/bk7258_pcm_main.c
@@ -0,0 +1,1289 @@
+/****************************************************************************
+ * apps/testing/bk7258_pcm/bk7258_pcm_main.c
+ *
+ * Minimal driver-validation utility for the BK7258 internal-DAC audio
+ * lower-half (/dev/audio/pcm0p).  Generates a fixed-frequency sine wave in
+ * memory, feeds it into the audio device via AUDIOIOC_ENQUEUEBUFFER and
+ * waits for AUDIO_MSG_COMPLETE.  Not a functional player.
+ *
+ * Usage:
+ *   bk7258_pcm [-r rate] [-c channels] [-f freq_hz] [-d duration_ms]
+ *              [-v volume]
+ *
+ * Defaults: 48 kHz, stereo, 1 kHz sine, 2000 ms, volume 80.
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/ioctl.h>
+#include <sys/types.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <mqueue.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/audio/audio.h>
+
+#ifdef CONFIG_AUDIO_BK7258
+#  include <arch/chip/bk7258_gdma.h>
+#  include <arch/chip/bk7258_dac.h>
+#  include <arch/chip/bk7258_adc.h>
+#endif
+
+#define PCM_DEV_PATH  "/dev/audio/pcm0p"
+#define MQ_NAME       "/bk7258_pcm_mq"
+
+static int      g_sample_rate   = 48000;
+static int      g_channels      = 2;
+static int      g_freq_hz       = 1000;
+static int      g_duration_ms   = 2000;
+static int      g_volume        = 20;
+static int      g_trace_mode    = 0; /* -T: sample regs instead of mq. */
+static int      g_fifo_cpu_mode = 0; /* -F: CPU-to-DAC FIFO boundary.  */
+static int      g_mclk_mode     = 0; /* -M: route I2S_MCLK to GPIO28.    */
+static int      g_capture_mode  = 0; /* -C: ADC capture clock detector.  */
+static int      g_loop_mode     = 0; /* -L: DTMF->DAC loopback probe.    */
+static int      g_nuttx_capture = 0; /* -N: capture via /dev/audio/pcm0c. */
+
+static void usage(FAR const char *prog)
+{
+  fprintf(stderr,
+          "Usage: %s [-r rate] [-c channels] [-f freq_hz]"
+          " [-d duration_ms] [-v volume] [-T] [-F] [-M] [-C] [-L] [-N]\n",
+          prog);
+  exit(EXIT_FAILURE);
+}
+
+static void parse_args(int argc, FAR char *argv[])
+{
+  int opt;
+
+  while ((opt = getopt(argc, argv, "r:c:f:d:v:TFMCLNh")) != -1)
+    {
+      switch (opt)
+        {
+          case 'r': g_sample_rate   = atoi(optarg); break;
+          case 'c': g_channels      = atoi(optarg); break;
+          case 'f': g_freq_hz       = atoi(optarg); break;
+          case 'd': g_duration_ms   = atoi(optarg); break;
+          case 'v': g_volume        = atoi(optarg); break;
+          case 'T': g_trace_mode    = 1;            break;
+          case 'F': g_fifo_cpu_mode = 1;            break;
+          case 'M': g_mclk_mode     = 1;            break;
+          case 'C': g_capture_mode  = 1;            break;
+          case 'L': g_loop_mode     = 1;            break;
+          case 'N': g_nuttx_capture = 1;            break;
+          case 'h':
+          default:  usage(argv[0]);
+        }
+    }
+}
+
+/* Fill an S16_LE buffer with a bounded sine wave at g_freq_hz.  phase is
+ * carried across buffers so sample-boundary discontinuities do not create
+ * audible clicks.
+ */
+
+/* Precomputed sine LUT: computing sin() per-sample inside the DEQUEUE
+ * refill path made the producer fall behind the DMA drain (underruns).
+ * Index the LUT by phase instead; no per-frame transcendental call.
+ */
+
+#define SINE_LUT_SIZE 256
+#define SINE_AMP      4000    /* peak sample; ~12% FS. */
+static int16_t g_sine_lut[SINE_LUT_SIZE];
+static bool    g_sine_lut_ready = false;
+
+static void sine_lut_init(void)
+{
+  int i;
+
+  if (g_sine_lut_ready)
+    {
+      return;
+    }
+
+  for (i = 0; i < SINE_LUT_SIZE; i++)
+    {
+      g_sine_lut[i] =
+        (int16_t)(SINE_AMP * sin(2.0 * M_PI * (double)i / SINE_LUT_SIZE));
+    }
+
+  g_sine_lut_ready = true;
+}
+
+static void fill_sine(FAR int16_t *dst, size_t nsamples,
+                      FAR double *phase)
+{
+  const double step  = 2.0 * M_PI * g_freq_hz / (double)g_sample_rate;
+  const double scale = (double)SINE_LUT_SIZE / (2.0 * M_PI);
+  size_t i;
+
+  sine_lut_init();
+
+  for (i = 0; i < nsamples; i += g_channels)
+    {
+      uint32_t idx = (uint32_t)(*phase * scale) & (SINE_LUT_SIZE - 1);
+      int16_t  s   = g_sine_lut[idx];
+      int c;
+
+      for (c = 0; c < g_channels; c++)
+        {
+          dst[i + c] = s;
+        }
+
+      *phase += step;
+      if (*phase >= 2.0 * M_PI)
+        {
+          *phase -= 2.0 * M_PI;
+        }
+    }
+}
+
+static int set_volume(int fd, int volume)
+{
+  struct audio_caps_desc_s cap;
+
+  memset(&cap, 0, sizeof(cap));
+  cap.caps.ac_len            = sizeof(struct audio_caps_s);
+  cap.caps.ac_type           = AUDIO_TYPE_FEATURE;
+  cap.caps.ac_format.hw      = AUDIO_FU_VOLUME;
+  cap.caps.ac_controls.hw[0] = (uint16_t)volume;
+  return ioctl(fd, AUDIOIOC_CONFIGURE, (unsigned long)&cap);
+}
+
+/* -N: capture through the NuttX audio framework device /dev/audio/pcm0c
+ * (open -> AUDIOIOC_CONFIGURE -> AUDIOIOC_START -> read loop -> STOP),
+ * rather than poking the ADC HAL directly like -C.  Validates that the
+ * capture lower-half feeds real samples to a read(2) caller the way the
+ * agent's NUTTX_DIRECT backend will.
+ */
+static int run_nuttx_capture(void)
+{
+  struct audio_caps_desc_s cap;
+  int16_t  buf[512];
+  int32_t  min = INT16_MAX, max = INT16_MIN, dc = 0;
+  uint32_t samples = 0;
+  uint32_t starved = 0;
+  uint32_t target;
+  int      fd;
+  int      ret;
+
+  /* pcm0c only supports 16 kHz mono S16_LE (matches the ASR path). */
+  target = 16000UL * (uint32_t)g_duration_ms / 1000UL;
+  if (target == 0)
+    {
+      target = 16000; /* 1 s fallback */
+    }
+
+  fd = open("/dev/audio/pcm0c", O_RDONLY);
+  if (fd < 0)
+    {
+      fprintf(stderr, "[bk-N] open(/dev/audio/pcm0c) failed: %d\n", errno);
+      return EXIT_FAILURE;
+    }
+  printf("[bk-N] pcm0c open ok\n"); fflush(stdout);
+
+  memset(&cap, 0, sizeof(cap));
+  cap.caps.ac_len            = sizeof(struct audio_caps_s);
+  cap.caps.ac_type           = AUDIO_TYPE_INPUT;
+  cap.caps.ac_channels       = 1;
+  cap.caps.ac_controls.hw[0] = 16000 & 0xFFFFu;
+  cap.caps.ac_controls.b[3]  = (uint8_t)(16000 >> 16);
+  cap.caps.ac_controls.b[2]  = 16;
+  cap.caps.ac_subtype        = AUDIO_FMT_PCM;
+
+  ret = ioctl(fd, AUDIOIOC_CONFIGURE, (unsigned long)&cap);
+  if (ret < 0)
+    {
+      fprintf(stderr, "[bk-N] AUDIOIOC_CONFIGURE(INPUT) failed: %d\n", errno);
+      close(fd);
+      return EXIT_FAILURE;
+    }
+  printf("[bk-N] cfg-in ok (16k mono S16_LE)\n"); fflush(stdout);
+
+  ret = ioctl(fd, AUDIOIOC_START, 0);
+  if (ret < 0)
+    {
+      fprintf(stderr, "[bk-N] AUDIOIOC_START failed: %d\n", errno);
+      close(fd);
+      return EXIT_FAILURE;
+    }
+  printf("[bk-N] start ok, capturing ~%lu ms\n",
+         (unsigned long)g_duration_ms); fflush(stdout);
+
+  while (samples < target)
+    {
+      ssize_t n = read(fd, buf, sizeof(buf));
+      if (n > 0)
+        {
+          int nsamp = (int)(n / (ssize_t)sizeof(int16_t));
+          int i;
+
+          for (i = 0; i < nsamp; i++)
+            {
+              int16_t s = buf[i];
+              if (s < min) min = s;
+              if (s > max) max = s;
+              dc += s;
+            }
+          samples += (uint32_t)nsamp;
+          starved = 0;
+        }
+      else if (n < 0)
+        {
+          if (errno == EAGAIN)
+            {
+              if (++starved > 2000)
+                {
+                  fprintf(stderr, "[bk-N] FIFO starved >2s, bailing\n");
+                  break;
+                }
+              usleep(1000);
+              continue;
+            }
+
+          fprintf(stderr, "[bk-N] read failed: %d\n", errno);
+          break;
+        }
+      else
+        {
+          /* EOF should not happen on a capture device. */
+          break;
+        }
+    }
+
+  (void)ioctl(fd, AUDIOIOC_STOP, 0);
+  close(fd);
+
+  printf("[bk-N] samples=%lu min=%ld max=%ld dc=%ld pp=%ld %s\n",
+         (unsigned long)samples, (long)min, (long)max,
+         (long)(samples ? dc / (int32_t)samples : 0),
+         (long)(samples ? (max - min) : 0),
+         (samples && (max - min) >= 200) ? "LIVE" : "FLAT?");
+
+  return EXIT_SUCCESS;
+}
+
+int main(int argc, FAR char *argv[])
