+#
+# For a description of the syntax of this configuration file,
+# see the file kconfig-language.txt in the NuttX tools repository.
+#
+
+config TESTING_BK7258_BTN
+	tristate "BK7258 /dev/btn0 short/long press monitor"
+	default n
+	depends on INPUT_BUTTONS
+	---help---
+		Monitors /dev/btn0 via poll() and classifies each key press as
+		short or long (held past the threshold).  Dispatch happens on
+		release; on_short_press()/on_long_press() are the two hooks the
+		business application wires into.  Intended for button-subsystem
+		bring-up and interaction-strategy prototyping on the BK7258 devkit.
+
+if TESTING_BK7258_BTN
+
+config TESTING_BK7258_BTN_PROGNAME
+	string "Program name"
+	default "bk7258_btn"
+
+config TESTING_BK7258_BTN_PRIORITY
+	int "Task priority"
+	default 100
+
+config TESTING_BK7258_BTN_STACKSIZE
+	int "Stack size"
+	default 4096
+
+config TESTING_BK7258_BTN_DEVPATH
+	string "Button device path"
+	default "/dev/btn0"
+
+config TESTING_BK7258_BTN_LONG_MS
+	int "Long press threshold (ms)"
+	default 800
+
+endif # TESTING_BK7258_BTN
