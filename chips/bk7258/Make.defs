############################################################################
# chips/bk7258/Make.defs
############################################################################

include armv8-m/Make.defs

CHIP_CSRCS += bk7258_irq.c bk7258_allocateheap.c bk7258_timer.c
CHIP_CSRCS += bk7258_ap_boot.c

ifeq ($(CONFIG_BK7258_MAILBOX),y)
CHIP_CSRCS += bk7258_mailbox.c
endif

ifeq ($(CONFIG_BK7258_COMPONENT_AP),y)
CHIP_CSRCS += bk7258_ap_start.c
else
CHIP_CSRCS += bk7258_start.c bk7258_clock.c bk7258_lowputc.c
CHIP_CSRCS += bk7258_uart.c bk7258_gpio.c
endif
